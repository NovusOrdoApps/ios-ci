default_platform(:ios)

platform :ios do

  # ──────────────────────────────────────────────
  # setup_keychain
  # ──────────────────────────────────────────────
  lane :setup_keychain do
    create_keychain(
      name: "fastlane_ci",
      password: "ci",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true,
    )
  end

  # ──────────────────────────────────────────────
  # install_profiles
  #
  # Usage: bundle exec fastlane install_profiles \
  #          type:appstore \
  #          app_identifiers:"com.foo.app,com.foo.app.widget"
  # ──────────────────────────────────────────────
  lane :install_profiles do |options|
    type = options[:type]
    ids = options[:app_identifiers].split(",")

    UI.user_error!("Missing 'type'") unless type
    UI.user_error!("Missing 'app_identifiers'") if ids.empty?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    match_opts = {
      type: type.to_s,
      api_key: api_key,
      app_identifier: ids,
      keychain_name: "fastlane_ci",
      keychain_password: "ci",
      readonly: false,
    }

    # Isolate each Apple team's certificates on its own branch in the match repo.
    # Match doesn't support multi-team in a single branch — its cert verification
    # treats every cert in the folder as belonging to the current team and
    # errors when it sees one that doesn't.
    #
    # Default: branch is "team-<IOS_RELEASE_TEAM_ID>". Override with MATCH_GIT_BRANCH.
    match_branch = ENV["MATCH_GIT_BRANCH"].to_s.strip
    if match_branch.empty?
      team_id = ENV["IOS_RELEASE_TEAM_ID"].to_s.strip
      match_branch = "team-#{team_id}" unless team_id.empty?
    end
    match_opts[:git_branch] = match_branch unless match_branch.empty?

    match_opts[:force_for_new_devices] = true if type.to_s == "adhoc"

    match(match_opts)
  end

  # ──────────────────────────────────────────────
  # set_signing
  #
  # Usage: bundle exec fastlane set_signing \
  #          type:appstore \
  #          targets_json:'[{"name":"Runner","bundle_id":"com.foo.app"}, ...]' \
  #          team_id:XXXXX \
  #          xcodeproj:Runner.xcodeproj
  # ──────────────────────────────────────────────
  lane :set_signing do |options|
    type = options[:type]
    team_id = options[:team_id]
    xcodeproj = options[:xcodeproj]
    targets = JSON.parse(options[:targets_json])

    match_type = type.to_s == "appstore" ? "AppStore" : "AdHoc"

    targets.each do |t|
      UI.message("Setting signing for target '#{t['name']}' → #{t['bundle_id']}")
      update_code_signing_settings(
        use_automatic_signing: false,
        team_id: team_id,
        targets: [t["name"]],
        profile_name: "match #{match_type} #{t['bundle_id']}",
        code_sign_identity: "Apple Distribution",
        bundle_identifier: t["bundle_id"],
        path: xcodeproj,
      )
    end
  end

  # ──────────────────────────────────────────────
  # upload_testflight_ipa
  # ──────────────────────────────────────────────
  lane :upload_testflight_ipa do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch("IPA_PATH"),
      skip_waiting_for_build_processing: true,
    )
  end

  # ──────────────────────────────────────────────
  # build_native
  #
  # Builds a non-Flutter Xcode project.
  # Usage: bundle exec fastlane build_native \
  #          workspace:App.xcworkspace \
  #          scheme:App \
  #          export_options:/path/to/ExportOptions.plist
  # ──────────────────────────────────────────────
  lane :build_native do |options|
    # build_app requires exactly ONE of workspace/project. Prefer workspace.
    # Workflow may pass "$GITHUB_WORKSPACE/" (repo root) when detection found no
    # workspace, so validate the actual value ends with .xcworkspace.
    workspace = options[:workspace].to_s.strip
    workspace = nil unless workspace.end_with?(".xcworkspace")

    project = options[:project].to_s.strip
    project = nil unless project.end_with?(".xcodeproj")

    if workspace.nil? && project.nil?
      UI.user_error!("Neither a .xcworkspace nor a .xcodeproj was provided to build_native.")
    end

    project = nil if workspace

    build_app(
      workspace: workspace,
      project: project,
      scheme: options[:scheme],
      configuration: options[:configuration].to_s.empty? ? "Release" : options[:configuration],
      export_options: options[:export_options],
      output_directory: "build/artifacts",
      output_name: "App.ipa",
      clean: true,
    )
  end

  # ──────────────────────────────────────────────
  # fetch_locales
  #
  # Queries App Store Connect for the app's active locales.
  # Writes a comma-separated list to GITHUB_OUTPUT or prints to stdout.
  # Usage: bundle exec fastlane fetch_locales
  # ──────────────────────────────────────────────
  lane :fetch_locales do
    require "spaceship"

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    app = Spaceship::ConnectAPI::App.find(ENV.fetch("APP_BUNDLE_ID"))
    UI.user_error!("App not found: #{ENV.fetch('APP_BUNDLE_ID')}") unless app

    # Get the latest editable or live version to read its locales
    version = app.get_edit_app_store_version || app.get_live_app_store_version
    UI.user_error!("No app version found on App Store Connect.") unless version

    localizations = version.get_app_store_version_localizations
    locales = localizations.map(&:locale).sort

    UI.message(":: Found #{locales.size} locale(s): #{locales.join(', ')}")

    # Write to GITHUB_OUTPUT if available, otherwise print
    output_file = ENV["GITHUB_OUTPUT"]
    if output_file
      File.open(output_file, "a") { |f| f.puts("locales=#{locales.join(',')}") }
    else
      puts "LOCALES=#{locales.join(',')}"
    end
  end

  # ──────────────────────────────────────────────
  # fetch_screenshots
  #
  # Downloads screenshots from App Store Connect (latest live or editable version)
  # to disk in this structure:
  #   {output_path}/Screenshots/{locale}/{display_type}/01.png, 02.png, ...
  #
  # display_type uses Apple's actual constants (e.g. APP_IPHONE_67,
  # APP_IPAD_PRO_3GEN_129, APP_IPAD_PRO_3GEN_11).
  #
  # Usage: bundle exec fastlane fetch_screenshots output_path:/path/to/repo
  # ──────────────────────────────────────────────
  lane :fetch_screenshots do |options|
    require "spaceship"
    require "fileutils"
    require "open-uri"

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    output_path = options[:output_path] || "."
    source = (options[:source] || "live").to_s  # "live" (default) or "edit"
    screenshots_dir = File.join(output_path, "Screenshots")
    FileUtils.mkdir_p(screenshots_dir)

    app = Spaceship::ConnectAPI::App.find(ENV.fetch("APP_BUNDLE_ID"))
    UI.user_error!("App not found: #{ENV.fetch('APP_BUNDLE_ID')}") unless app

    version =
      case source
      when "edit"
        app.get_edit_app_store_version || app.get_live_app_store_version
      when "live"
        app.get_live_app_store_version || app.get_edit_app_store_version
      else
        UI.user_error!("Invalid source '#{source}'. Use 'live' or 'edit'.")
      end
    UI.user_error!("No app version found on App Store Connect.") unless version

    UI.message(":: Fetching from version #{version.version_string} (state: #{version.app_store_state}, source preference: #{source})")

    localizations = version.get_app_store_version_localizations

    total_screenshots = 0

    localizations.each do |loc|
      locale = loc.locale
      screenshot_sets = loc.get_app_screenshot_sets(includes: "appScreenshots")

      if screenshot_sets.empty?
        UI.message(":: #{locale}: no screenshots")
        next
      end

      locale_count = 0

      screenshot_sets.each do |set|
        display_type = set.screenshot_display_type
        next if display_type.nil?

        screenshots = set.app_screenshots || []
        next if screenshots.empty?

        device_dir = File.join(screenshots_dir, locale, display_type)
        FileUtils.mkdir_p(device_dir)

        screenshots.each_with_index do |shot, idx|
          url = shot.image_asset_url(type: "png")
          unless url
            UI.important(":: #{locale}/#{display_type}: screenshot #{idx + 1} has no image_asset (skipping)")
            next
          end

          filename = format("%02d.png", idx + 1)
          out_path = File.join(device_dir, filename)

          URI.open(url) do |remote|
            File.binwrite(out_path, remote.read)
          end

          locale_count += 1
          total_screenshots += 1
        end
      end

      UI.message(":: #{locale}: #{locale_count} screenshot(s) downloaded")
    end

    UI.success("Downloaded #{total_screenshots} screenshot(s) across #{localizations.size} locale(s) to #{screenshots_dir}.")
  end

  # ──────────────────────────────────────────────
  # fetch_metadata
  #
  # Downloads metadata from App Store Connect via Spaceship,
  # writing each locale's fields to deliver-compatible format:
  #   {output_path}/metadata/{locale}/{field}.txt
  #
  # Usage: bundle exec fastlane fetch_metadata output_path:/tmp/asc-metadata
  # ──────────────────────────────────────────────
  lane :fetch_metadata do |options|
    require "spaceship"
    require "fileutils"

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    output_path = options[:output_path] || "."
    source = (options[:source] || "live").to_s  # "live" (default) or "edit"
    metadata_dir = File.join(output_path, "metadata")
    FileUtils.mkdir_p(metadata_dir)

    app = Spaceship::ConnectAPI::App.find(ENV.fetch("APP_BUNDLE_ID"))
    UI.user_error!("App not found: #{ENV.fetch('APP_BUNDLE_ID')}") unless app

    version, app_info =
      case source
      when "edit"
        [app.get_edit_app_store_version || app.get_live_app_store_version,
         app.fetch_edit_app_info || app.fetch_live_app_info]
      when "live"
        [app.get_live_app_store_version || app.get_edit_app_store_version,
         app.fetch_live_app_info || app.fetch_edit_app_info]
      else
        UI.user_error!("Invalid source '#{source}'. Use 'live' or 'edit'.")
      end
    UI.user_error!("No app version found on App Store Connect.") unless version

    UI.message(":: Fetching from version #{version.version_string} (state: #{version.app_store_state}, source preference: #{source})")

    # Per-version localizations (description, keywords, marketing_url, promotional_text, support_url, whats_new)
    version_localizations = version.get_app_store_version_localizations
    app_info_by_locale = {}
    if app_info
      app_info.get_app_info_localizations.each do |info_loc|
        app_info_by_locale[info_loc.locale] = info_loc
      end
    end

    version_localizations.each do |loc|
      locale_dir = File.join(metadata_dir, loc.locale)
      FileUtils.mkdir_p(locale_dir)

      written = 0
      {
        "description.txt"      => loc.description,
        "keywords.txt"         => loc.keywords,
        "marketing_url.txt"    => loc.marketing_url,
        "promotional_text.txt" => loc.promotional_text,
        "support_url.txt"      => loc.support_url,
        "release_notes.txt"    => loc.whats_new,
      }.each do |filename, value|
        next if value.nil? || value.to_s.strip.empty?

        File.write(File.join(locale_dir, filename), value)
        written += 1
      end

      info_loc = app_info_by_locale[loc.locale]
      if info_loc
        {
          "name.txt"        => info_loc.name,
          "subtitle.txt"    => info_loc.subtitle,
          "privacy_url.txt" => info_loc.privacy_policy_url,
        }.each do |filename, value|
          next if value.nil? || value.to_s.strip.empty?

          File.write(File.join(locale_dir, filename), value)
          written += 1
        end
      end

      UI.message(":: #{loc.locale}: #{written} field(s) written")
    end

    UI.success("Downloaded metadata for #{version_localizations.size} locale(s) to #{metadata_dir}.")
  end

  # ──────────────────────────────────────────────
  # submit_for_review
  #
  # Auto-selects the latest editable version and latest TestFlight build,
  # then submits for review with automatic_release enabled.
  #
  # Requires: submission_info_path pointing to a submission.jsonc file with
  # answers to Apple's review questions.
  #
  # Usage: bundle exec fastlane submit_for_review \
  #          submission_info_path:/path/to/submission.jsonc
  # ──────────────────────────────────────────────
  lane :submit_for_review do |options|
    require "spaceship"
    require "json"

    submission_info_path = options[:submission_info_path]
    UI.user_error!("Missing submission_info_path") if submission_info_path.to_s.empty?
    UI.user_error!("Submission info file not found: #{submission_info_path}") unless File.exist?(submission_info_path)

    # Parse submission info (JSONC-compatible; strips // comments and trailing commas)
    raw = File.read(submission_info_path)
    raw = raw.delete_prefix("\xEF\xBB\xBF")
    raw = raw.gsub(%r{^\s*//.*$}, "").gsub(/,\s*([}\]])/, '\1')
    submission_info = JSON.parse(raw)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    app = Spaceship::ConnectAPI::App.find(ENV.fetch("APP_BUNDLE_ID"))
    UI.user_error!("App not found: #{ENV.fetch('APP_BUNDLE_ID')}") unless app

    # Find the current editable version
    version = app.get_edit_app_store_version
    UI.user_error!("No editable version found on App Store Connect. Create one via Update Metadata first.") unless version

    app_version = version.version_string
    UI.message(":: Editable version: #{app_version}")

    # Find latest build (sorted by upload date desc, limit 1)
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      sort: "-uploadedDate",
      limit: 1,
    )
    UI.user_error!("No builds found in TestFlight for #{app.bundle_id}") if builds.empty?

    build = builds.first
    build_number = build.version
    UI.message(":: Latest TestFlight build: #{build_number}")

    # If submission_info contains a `uses_idfa` key, PATCH it onto the
    # version BEFORE deliver runs. `deliver`/Spaceship's AppStoreVersion
    # model has no usesIdfa attr, so it's silently dropped if you put it
    # in submission_information directly. Recon: docs/recon/usesIdfa.md
    # in NovusOrdoApps/asc-ops-workflow.
    if submission_info.key?("uses_idfa")
      uses_idfa = submission_info["uses_idfa"]   # true / false / null
      Spaceship::ConnectAPI.client.tunes_request_client.patch(
        "v1/appStoreVersions/#{version.id}",
        { data: { type: "appStoreVersions", id: version.id, attributes: { usesIdfa: uses_idfa } } },
      )
      UI.message(":: Set usesIdfa=#{uses_idfa.inspect} on version #{app_version}")
    end

    deliver(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_BUNDLE_ID"),
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: submission_info,
      precheck_include_in_app_purchases: false,
    )

    UI.success("Submitted version #{app_version} (build #{build_number}) for review with automatic release.")
  end

  # ──────────────────────────────────────────────
  # update_metadata
  #
  # Uploads metadata and/or screenshots to App Store Connect.
  # Usage: bundle exec fastlane update_metadata \
  #          metadata_path:/tmp/deliver/metadata \
  #          screenshots_path:/tmp/deliver/screenshots \
  #          skip_screenshots:true \
  #          app_version:2.5.0
  # ──────────────────────────────────────────────
  lane :update_metadata do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    # Live-only promotional_text path: when we're updating only promotional_text
    # and the app has no editable version, bypass `deliver` and write to the
    # live version's localizations via the ASC API. `deliver` hangs on
    # `fetch_edit_app_info` even with `edit_live: true` because Apple does not
    # expose an editable AppInfo for a Ready-for-Sale-only app, so deliver is
    # not usable for this case. Apple does allow promotional_text edits on the
    # live AppStoreVersion's localizations directly.
    if options[:update_promotional_text_only].to_s == "true" && options[:app_version].to_s.empty?
      app = Spaceship::ConnectAPI::App.find(ENV.fetch("APP_BUNDLE_ID"))
      UI.user_error!("App not found: #{ENV.fetch('APP_BUNDLE_ID')}") unless app

      if app.get_edit_app_store_version.nil?
        live_version = app.get_live_app_store_version(platform: "IOS")
        UI.user_error!("No live version found on App Store Connect.") unless live_version

        UI.message(":: No editable version found — updating promotional_text on live version #{live_version.version_string} via ASC API.")

        by_locale = live_version.get_app_store_version_localizations.each_with_object({}) do |loc, h|
          h[loc.locale] = loc
        end

        updated = 0
        Dir.children(options[:metadata_path]).sort.each do |locale|
          promo_path = File.join(options[:metadata_path], locale, "promotional_text.txt")
          next unless File.file?(promo_path)
          promo = File.read(promo_path).strip
          next if promo.empty?

          loc = by_locale[locale]
          if loc.nil?
            UI.important(":: Skipping #{locale}: no matching localization on the live version.")
            next
          end

          loc.update(attributes: { promotional_text: promo })
          UI.message(":: Updated promotional_text for #{locale}")
          updated += 1
        end

        UI.success("Updated promotional_text for #{updated} locale(s) on the live version.")
        next
      end

      UI.message(":: Editable version found — falling through to deliver.")
    end

    deliver_opts = {
      api_key: api_key,
      app_identifier: ENV.fetch("APP_BUNDLE_ID"),
      metadata_path: options[:metadata_path],
      skip_binary_upload: true,
      force: true,
      precheck_include_in_app_purchases: false,
    }

    deliver_opts[:app_version] = options[:app_version] unless options[:app_version].to_s.empty?

    if options[:skip_screenshots].to_s == "true"
      deliver_opts[:skip_screenshots] = true
    else
      deliver_opts[:skip_screenshots] = false
      deliver_opts[:screenshots_path] = options[:screenshots_path]
      deliver_opts[:overwrite_screenshots] = true
    end

    deliver(deliver_opts)
  end

  # ──────────────────────────────────────────────
  # update_iap
  #
  # Reads the normalized IAP JSON written by transform_iap.rb and creates or
  # updates in-app purchases on App Store Connect via the Spaceship V2 API.
  #
  # Idempotent: looks up each product by product_id, creates if missing,
  # updates in place if present. After updates, attempts to transition each
  # product to the "Ready to Submit" state — a best-effort step that logs a
  # warning if Apple rejects the transition (typically because a required
  # field, like a review screenshot for first submission, is missing).
  #
  # Usage: bundle exec fastlane update_iap input_path:/tmp/iap-normalized.json
  # ──────────────────────────────────────────────
  lane :update_iap do |options|
    require "spaceship"
    require "json"

    input_path = options[:input_path]
    UI.user_error!("Missing input_path") if input_path.to_s.empty?
    UI.user_error!("IAP input file not found: #{input_path}") unless File.exist?(input_path)

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    app = find_iap_app_or_explain!(ENV.fetch("APP_BUNDLE_ID"))

    source = JSON.parse(File.read(input_path))
    products = source.fetch("products", [])
    UI.user_error!("No products in #{input_path}") if products.empty?

    type_to_apple = {
      "consumable"               => "CONSUMABLE",
      "non_consumable"           => "NON_CONSUMABLE",
      "non_renewing_subscription" => "NON_RENEWING_SUBSCRIPTION",
    }.freeze

    existing = {}
    list_app_iaps(app.id).each do |iap|
      existing[iap.dig("attributes", "productId")] = iap
    end
    UI.message(":: App has #{existing.size} existing IAP(s) on ASC")

    warnings = []

    products.each do |product|
      pid = product.fetch("product_id")
      apple_type = type_to_apple.fetch(product.fetch("type"))
      iap = existing[pid]

      if iap.nil?
        UI.message(":: Creating IAP '#{pid}' (type=#{apple_type})")
        iap = create_iap(
          app_id: app.id,
          product_id: pid,
          name: product.fetch("reference_name"),
          in_app_purchase_type: apple_type,
          family_sharable: product.fetch("family_shareable", false),
        )
      else
        attrs = {}
        if iap.dig("attributes", "name") != product["reference_name"]
          attrs[:name] = product["reference_name"]
        end
        current_fs = iap.dig("attributes", "familySharable")
        if !current_fs.nil? && current_fs != product["family_shareable"]
          attrs[:familySharable] = product["family_shareable"]
        end
        unless attrs.empty?
          UI.message(":: Updating IAP '#{pid}' (#{attrs.keys.join(', ')})")
          iap = update_iap_attrs(iap_id: iap["id"], attrs: attrs)
        end
      end

      iap_id = iap["id"]
      sync_iap_localizations(iap_id: iap_id, pid: pid, source_locs: product.fetch("localizations"))

      # Price: accept "customer_price" (USD string, e.g. "0.99") OR legacy
      # "price_tier" key for back-compat (treat as USD price for now;
      # apps that need true legacy-tier-1-to-100 mapping should switch
      # to customer_price).
      desired_price = product["customer_price"] || product["price_tier"]
      if desired_price
        begin
          sync_iap_price(iap_id: iap_id, customer_price: desired_price)
        rescue StandardError => e
          warnings << "#{pid}: price update failed: #{e.message}"
        end
      end

      if product["territories"]
        begin
          # "ALL" sentinel expands to Apple's canonical territory list
          # (live, so newly-added territories get picked up automatically
          # without bumping a hardcoded snapshot in this repo).
          territories = product["territories"]
          territories = fetch_all_apple_territories if territories == "ALL"
          sync_iap_availability(
            iap_id: iap_id,
            territories: territories,
            available_in_new_territories: product.fetch("available_in_new_territories", true)
          )
        rescue StandardError => e
          warnings << "#{pid}: availability update failed: #{e.message}"
        end
      end

      if product["review_screenshot"]
        begin
          upload_iap_review_screenshot(iap_id: iap_id, path: product["review_screenshot"])
        rescue StandardError => e
          warnings << "#{pid}: review screenshot upload failed: #{e.message}"
        end
      end

      begin
        submit_iap_for_review(iap_id: iap_id)
      rescue StandardError => e
        warnings << "#{pid}: transition to 'Ready to Submit' failed: #{e.message}"
      end
    end

    warnings.each { |w| UI.important(":: #{w}") }
    UI.success("Processed #{products.length} IAP(s)#{warnings.any? ? " with #{warnings.size} warning(s)" : ''}.")
  end

  # ──────────────────────────────────────────────
  # fetch_iap
  #
  # Downloads consumable + non-consumable IAPs from App Store Connect into a
  # flat dump that reverse_transform_iap.rb consumes:
  #   {output_path}/{product_id}/product.json
  #   {output_path}/{product_id}/review_screenshot.png  (if present)
  #   {output_path}/{product_id}/Text/{locale}/info.json
  #
  # Usage: bundle exec fastlane fetch_iap output_path:/tmp/iap-dump
  # ──────────────────────────────────────────────
  lane :fetch_iap do |options|
    require "spaceship"
    require "fileutils"
    require "json"
    require "open-uri"

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    output_path = options[:output_path] || "."
    FileUtils.mkdir_p(output_path)

    app = find_iap_app_or_explain!(ENV.fetch("APP_BUNDLE_ID"))

    iaps = list_app_iaps(app.id)
    apple_to_type = {
      "CONSUMABLE"               => "consumable",
      "NON_CONSUMABLE"           => "non_consumable",
      "NON_RENEWING_SUBSCRIPTION" => "non_renewing_subscription",
    }.freeze

    written = 0

    iaps.each do |iap|
      product_id = iap.dig("attributes", "productId")
      type = apple_to_type[iap.dig("attributes", "inAppPurchaseType")]
      next unless type   # skip subscriptions / non-consumable / etc. we don't manage

      product_dir = File.join(output_path, product_id)
      FileUtils.mkdir_p(product_dir)

      family_sharable = iap.dig("attributes", "familySharable")
      family_sharable = false if family_sharable.nil?

      availability = fetch_iap_availability(iap_id: iap["id"]) || {}
      territories = availability["territories"] || []
      # Compress to the "ALL" sentinel when the IAP is sold in every
      # Apple-supported territory — keeps synced PRs readable instead
      # of dumping 175 alpha-3 codes into the diff.
      all_apple = fetch_all_apple_territories
      territories_field = (territories.size == all_apple.size && territories == all_apple) ? "ALL" : territories

      meta = {
        "type"                         => type,
        "reference_name"               => iap.dig("attributes", "name"),
        "customer_price"               => fetch_iap_price_tier(iap_id: iap["id"]),
        "territories"                  => territories_field,
        "available_in_new_territories" => availability.fetch("available_in_new_territories", true),
        "family_shareable"             => family_sharable,
      }
      File.write(File.join(product_dir, "product.json"), JSON.pretty_generate(meta))

      text_dir = File.join(product_dir, "Text")
      FileUtils.mkdir_p(text_dir)

      list_iap_localizations(iap["id"]).each do |loc|
        locale = loc.dig("attributes", "locale")
        next if locale.to_s.empty?
        locale_dir = File.join(text_dir, locale)
        FileUtils.mkdir_p(locale_dir)
        File.write(
          File.join(locale_dir, "info.json"),
          JSON.pretty_generate({
            "name"        => loc.dig("attributes", "name"),
            "description" => loc.dig("attributes", "description"),
          }),
        )
      end

      begin
        download_iap_review_screenshot(iap_id: iap["id"], dest_path: File.join(product_dir, "review_screenshot.png"))
      rescue StandardError => e
        UI.important(":: #{product_id}: could not download review screenshot: #{e.message}")
      end

      written += 1
      UI.message(":: Dumped #{product_id}")
    end

    UI.success("Dumped #{written} IAP(s) to #{output_path}.")
  end

  # ──────────────────────────────────────────────
  # register_bundle_id
  #
  # Register a bundle ID in the Apple Developer portal via the public
  # ASC REST API: POST /v1/bundleIds. Idempotent — looks for an
  # existing bundle ID with the same identifier first; only POSTs if
  # absent. Returns the bundle ID's opaque resource ID via lane_context.
  #
  # Required for any new app whose bundle ID hasn't been registered
  # yet — bundle IDs registered in the Developer portal automatically
  # appear in App Store Connect's bundle ID dropdown, which the
  # asc-ops-workflow `create_app` lane consumes.
  #
  # Usage: bundle exec fastlane register_bundle_id \
  #          identifier:com.example.myapp \
  #          name:"My Awesome App" \
  #          platform:UNIVERSAL
  # ──────────────────────────────────────────────
  lane :register_bundle_id do |options|
    require "spaceship"

    identifier = options[:identifier] || ENV["APP_BUNDLE_ID"]
    UI.user_error!("Missing identifier (or APP_BUNDLE_ID env)") if identifier.to_s.empty?

    name = options[:name] || identifier
    platform = options[:platform] || "IOS"   # IOS | MAC_OS (Apple's REST accepts only these)

    UI.user_error!("Invalid platform #{platform.inspect}; valid: IOS | MAC_OS") \
      unless %w[IOS MAC_OS].include?(platform)

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    client = Spaceship::ConnectAPI.client.provisioning_request_client

    # Look for existing bundle ID by identifier (idempotency)
    existing_resp = client.get("v1/bundleIds", { "filter[identifier]" => identifier, "limit" => 1 })
    existing = existing_resp.body["data"]&.first

    if existing
      UI.success(":: Bundle ID already exists: #{identifier} → #{existing['id']}")
      next existing["id"]
    end

    # POST a new one
    resp = client.post("v1/bundleIds", {
      data: {
        type: "bundleIds",
        attributes: { identifier: identifier, name: name, platform: platform },
      }
    })

    new_id = resp.body.dig("data", "id")
    UI.success(":: Registered bundle ID #{identifier} → #{new_id}")
    new_id
  end

  # ──────────────────────────────────────────────
  # update_app_info / fetch_app_info
  #
  # Single source of truth for the simple (PATCH-able / single-resource)
  # fields on the App Information page. Reads metadata/AppInfo/app_info.jsonc.
  # Each section is optional — the lane only touches sections present
  # in the file. Idempotent: only PATCHes when state diverges.
  #
  # Sections currently supported:
  #   accessibility_url        → PATCH /v1/apps/<id>.attributes.accessibilityUrl
  #   subscription_status_urls → PATCH /v1/apps/<id>.attributes.subscriptionStatusUrl{,ForSandbox,Version,VersionForSandbox}
  #   content_rights           → PATCH /v1/apps/<id>.attributes.contentRightsDeclaration
  #   eula                     → CREATE/UPDATE/DELETE /v1/endUserLicenseAgreements
  #
  # Stays out of scope (separate lanes; different complexity):
  #   - Accessibility declarations (per-deviceFamily matrix; update_accessibility lane)
  #   - Age rating questionnaire (matrix; not yet implemented)
  #   - Per-locale fields (name, subtitle, privacy_url) — handled by metadata pipeline
  #
  # The per-section lanes (update_accessibility, update_eula,
  # update_subscription_status_url) are kept around for backwards
  # compatibility with existing app repos. New repos should use this
  # unified lane via ios-app-info.yml.
  #
  # Usage:
  #   bundle exec fastlane update_app_info input_path:/path/to/app_info.jsonc
  #   bundle exec fastlane fetch_app_info  output_path:/path/to/repo/metadata/AppInfo
  # ──────────────────────────────────────────────
  lane :update_app_info do |options|
    require "spaceship"

    input_path = options[:input_path]
    UI.user_error!("Missing input_path") if input_path.to_s.empty?
    UI.user_error!("App info file not found: #{input_path}") unless File.exist?(input_path)

    spec = parse_jsonc(File.read(input_path))
    if spec.empty?
      UI.message(":: app_info.jsonc is empty; nothing to do")
      next
    end

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    app = find_iap_app_or_explain!(ENV.fetch("APP_BUNDLE_ID"))
    client = Spaceship::ConnectAPI.client.tunes_request_client

    # Compute desired App attributes from the app-level sections.
    # All four ride on the same PATCH /v1/apps/<id> call so we coalesce
    # them into a single diff to avoid 4 round trips.
    desired_app_attrs = {}

    if spec.key?("accessibility_url")
      desired_app_attrs["accessibilityUrl"] = spec["accessibility_url"]
    end

    if spec.key?("subscription_status_urls")
      sub = spec["subscription_status_urls"] || {}
      valid = %w[V1 V2].freeze
      if sub.key?("production_url")
        desired_app_attrs["subscriptionStatusUrl"] = sub["production_url"]
        v = sub["production_version"] || (sub["production_url"] ? "V2" : nil)
        UI.user_error!("subscription_status_urls.production_version must be V1|V2") if v && !valid.include?(v)
        desired_app_attrs["subscriptionStatusUrlVersion"] = v
      end
      if sub.key?("sandbox_url")
        desired_app_attrs["subscriptionStatusUrlForSandbox"] = sub["sandbox_url"]
        v = sub["sandbox_version"] || (sub["sandbox_url"] ? "V2" : nil)
        UI.user_error!("subscription_status_urls.sandbox_version must be V1|V2") if v && !valid.include?(v)
        desired_app_attrs["subscriptionStatusUrlVersionForSandbox"] = v
      end
    end

    if spec.key?("content_rights")
      cr = spec["content_rights"] || {}
      if cr.key?("uses_third_party_content")
        # Apple's enum: USES_THIRD_PARTY_CONTENT | DOES_NOT_USE_THIRD_PARTY_CONTENT
        flag = cr["uses_third_party_content"] ? true : false
        desired_app_attrs["contentRightsDeclaration"] =
          flag ? "USES_THIRD_PARTY_CONTENT" : "DOES_NOT_USE_THIRD_PARTY_CONTENT"
      end
    end

    unless desired_app_attrs.empty?
      # Read current state to keep idempotent
      field_list = desired_app_attrs.keys.join(",")
      current = client.get("v1/apps/#{app.id}", { "fields[apps]" => field_list }).body.dig("data", "attributes") || {}
      diff = desired_app_attrs.reject { |k, v| current[k] == v }

      if diff.empty?
        UI.message(":: All app attributes already at desired state; no PATCH sent")
      else
        client.patch("v1/apps/#{app.id}", {
          data: { type: "apps", id: app.id, attributes: diff },
        })
        diff.each { |k, v| UI.success(":: #{k}: #{current[k].inspect} → #{v.inspect}") }
      end
    end

    # Subscription grace period — singleton resource on the app
    # (/v1/apps/<id>/subscriptionGracePeriod GET → /v1/subscriptionGracePeriods/<id> PATCH).
    # When a subscriber's renewal payment fails, Apple retries for the
    # configured duration and the subscriber retains access during it.
    if spec.key?("subscription_grace_period")
      gp_in = spec["subscription_grace_period"] || {}
      valid_durations = %w[THREE_DAYS SIXTEEN_DAYS TWENTY_EIGHT_DAYS].freeze
      valid_renewal   = %w[ALL_RENEWALS PAID_TO_PAID_ONLY].freeze

      if gp_in["duration"] && !valid_durations.include?(gp_in["duration"])
        UI.user_error!("subscription_grace_period.duration must be one of #{valid_durations} (got #{gp_in['duration'].inspect})")
      end
      if gp_in["renewal_type"] && !valid_renewal.include?(gp_in["renewal_type"])
        UI.user_error!("subscription_grace_period.renewal_type must be one of #{valid_renewal} (got #{gp_in['renewal_type'].inspect})")
      end

      gp_resp = client.get("v1/apps/#{app.id}/subscriptionGracePeriod").body
      gp_data = gp_resp["data"]
      if gp_data.nil?
        UI.important(":: subscription_grace_period: no grace-period resource exists for this app yet; Apple usually creates one automatically when the app first has subs. Skipping.")
      else
        gp_id   = gp_data["id"]
        gp_curr = gp_data["attributes"] || {}

        desired_gp = {}
        desired_gp["optIn"]        = gp_in["production_opt_in"] if gp_in.key?("production_opt_in")
        desired_gp["sandboxOptIn"] = gp_in["sandbox_opt_in"]    if gp_in.key?("sandbox_opt_in")
        desired_gp["duration"]     = gp_in["duration"]          if gp_in.key?("duration")
        desired_gp["renewalType"]  = gp_in["renewal_type"]      if gp_in.key?("renewal_type")

        diff_gp = desired_gp.reject { |k, v| gp_curr[k] == v }
        if diff_gp.empty?
          UI.message(":: subscription_grace_period: already at desired state")
        else
          client.patch("v1/subscriptionGracePeriods/#{gp_id}", {
            data: { type: "subscriptionGracePeriods", id: gp_id, attributes: diff_gp }
          })
          diff_gp.each { |k, v| UI.success(":: subscription_grace_period.#{k}: #{gp_curr[k].inspect} → #{v.inspect}") }
        end
      end
    end

    # EULA section — separate resource family (endUserLicenseAgreements).
    # Mirrors update_eula lane: text-only changes PATCH; territory
    # changes force DELETE+POST (territories are immutable).
    if spec.key?("eula")
      eula        = spec["eula"] || {}
      desired_text = eula["agreement_text"]
      desired_terr = (eula["territories"] || []).sort

      existing_eula = client.get("v1/apps/#{app.id}/endUserLicenseAgreement").body["data"]

      cleanup_case = (desired_text.to_s.empty? || desired_terr.empty?) && existing_eula
      if cleanup_case
        client.delete("v1/endUserLicenseAgreements/#{existing_eula['id']}")
        UI.success(":: eula: deleted custom EULA #{existing_eula['id']}")
      elsif desired_text.to_s.empty? || desired_terr.empty?
        UI.message(":: eula: no custom agreement configured; nothing to do")
      elsif existing_eula
        existing_id   = existing_eula["id"]
        existing_text = existing_eula.dig("attributes", "agreementText")
        tr_resp       = client.get("v1/endUserLicenseAgreements/#{existing_id}/relationships/territories", { "limit" => 200 })
        existing_terr = (tr_resp.body["data"] || []).map { |t| t["id"] }.sort

        if existing_terr != desired_terr
          UI.important(":: eula: territory list changed; recreating")
          client.delete("v1/endUserLicenseAgreements/#{existing_id}")
          client.post("v1/endUserLicenseAgreements", {
            data: {
              type: "endUserLicenseAgreements",
              attributes: { agreementText: desired_text },
              relationships: {
                app: { data: { type: "apps", id: app.id } },
                territories: { data: desired_terr.map { |t| { type: "territories", id: t } } },
              },
            },
          })
          UI.success(":: eula: created with #{desired_terr.size} territory(ies)")
        elsif existing_text != desired_text
          client.patch("v1/endUserLicenseAgreements/#{existing_id}", {
            data: { type: "endUserLicenseAgreements", id: existing_id, attributes: { agreementText: desired_text } },
          })
          UI.success(":: eula: text updated on #{existing_id}")
        else
          UI.message(":: eula: already at desired state")
        end
      else
        client.post("v1/endUserLicenseAgreements", {
          data: {
            type: "endUserLicenseAgreements",
            attributes: { agreementText: desired_text },
            relationships: {
              app: { data: { type: "apps", id: app.id } },
              territories: { data: desired_terr.map { |t| { type: "territories", id: t } } },
            },
          },
        })
        UI.success(":: eula: created custom EULA covering #{desired_terr.size} territory(ies)")
      end
    end

    UI.success("Done")
  end

  lane :fetch_app_info do |options|
    require "spaceship"
    require "fileutils"

    output_path = options[:output_path] || "."
    FileUtils.mkdir_p(output_path)

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    app = find_iap_app_or_explain!(ENV.fetch("APP_BUNDLE_ID"))
    client = Spaceship::ConnectAPI.client.tunes_request_client

    fields = "accessibilityUrl,subscriptionStatusUrl,subscriptionStatusUrlForSandbox,subscriptionStatusUrlVersion,subscriptionStatusUrlVersionForSandbox,contentRightsDeclaration"
    attrs = client.get("v1/apps/#{app.id}", { "fields[apps]" => fields }).body.dig("data", "attributes") || {}

    out = {}
    out["accessibility_url"] = attrs["accessibilityUrl"] if attrs.key?("accessibilityUrl")

    if attrs.values_at("subscriptionStatusUrl", "subscriptionStatusUrlForSandbox").any?
      out["subscription_status_urls"] = {
        "production_url"     => attrs["subscriptionStatusUrl"],
        "sandbox_url"        => attrs["subscriptionStatusUrlForSandbox"],
        "production_version" => attrs["subscriptionStatusUrlVersion"],
        "sandbox_version"    => attrs["subscriptionStatusUrlVersionForSandbox"],
      }
    end

    if attrs["contentRightsDeclaration"]
      out["content_rights"] = {
        "uses_third_party_content" => attrs["contentRightsDeclaration"] == "USES_THIRD_PARTY_CONTENT",
      }
    end

    gp_resp = client.get("v1/apps/#{app.id}/subscriptionGracePeriod").body
    if gp_resp["data"]
      gp_attrs = gp_resp.dig("data", "attributes") || {}
      out["subscription_grace_period"] = {
        "production_opt_in" => gp_attrs["optIn"],
        "sandbox_opt_in"    => gp_attrs["sandboxOptIn"],
        "duration"          => gp_attrs["duration"],
        "renewal_type"      => gp_attrs["renewalType"],
      }
    end

    eula_resp = client.get("v1/apps/#{app.id}/endUserLicenseAgreement").body
    if eula_resp["data"]
      eula_id = eula_resp.dig("data", "id")
      tr_resp = client.get("v1/endUserLicenseAgreements/#{eula_id}/relationships/territories", { "limit" => 200 })
      out["eula"] = {
        "agreement_text" => eula_resp.dig("data", "attributes", "agreementText"),
        "territories"    => (tr_resp.body["data"] || []).map { |t| t["id"] }.sort,
      }
    end

    out_file = File.join(output_path, "app_info.json")
    File.write(out_file, JSON.pretty_generate(out))
    UI.success(":: Wrote #{out.keys.size} section(s) to #{out_file}: #{out.keys.join(', ')}")
  end

  # ── IAP helpers (private to update_iap / fetch_iap) ──────────

  # Spaceship's App.find does a partial filter through Apple's API then an
  # exact match in Ruby. When it returns nil, the bare error is unhelpful —
  # the user can't tell typo vs. access vs. case mismatch. This helper
  # surfaces what the API key can actually see so the cause is obvious.
  def find_iap_app_or_explain!(bundle_id)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    return app if app

    hint =
      begin
        partial = Spaceship::ConnectAPI.get_apps(filter: { bundleId: bundle_id }).to_models
        if partial.empty?
          visible = Spaceship::ConnectAPI.get_apps(limit: 20).to_models.map(&:bundle_id)
          if visible.empty?
            "API key has access to 0 apps. Check the key's role and app access in App Store Connect."
          else
            "API key sees no apps matching '#{bundle_id}'. Visible bundle IDs (first 20): #{visible.join(', ')}"
          end
        else
          near = partial.map(&:bundle_id).reject { |b| b == bundle_id }.uniq
          "API returned #{partial.size} partial match(es) but none equal '#{bundle_id}'. Closest: #{near.join(', ')}"
        end
      rescue StandardError => e
        "(diagnostic lookup failed: #{e.message})"
      end

    UI.user_error!("App not found: '#{bundle_id}'\n        #{hint}")
  end

  # ── IAP V2 raw-HTTP helpers ──
  # fastlane's Spaceship has no ConnectAPI model class for IAP V2
  # (verified against master HEAD: zero in_app_purchase*.rb files in
  # spaceship/lib/spaceship/connect_api/models/, and no IAP methods
  # in connect_api/tunes/tunes.rb either). The earlier code referenced
  # `Spaceship::ConnectAPI::InAppPurchaseV2` which doesn't exist —
  # that's why update_iap and fetch_iap crashed. These helpers go
  # through tunes_request_client directly with the JSON:API shapes
  # captured against Apple's iris API on 2026-05-07.
  #
  # Each helper returns the raw JSON:API resource Hash (data["data"]
  # or array of data["data"]), keyed by string accessors:
  #   iap["id"]                              ← Apple App Store ID (numeric string)
  #   iap.dig("attributes", "productId")
  #   iap.dig("attributes", "name")
  #   iap.dig("attributes", "inAppPurchaseType")  → "CONSUMABLE" / "NON_CONSUMABLE" / etc.
  #   iap.dig("attributes", "familySharable")
  #   iap.dig("attributes", "state")              → "MISSING_METADATA" / "READY_TO_SUBMIT" / etc.

  def iap_client
    Spaceship::ConnectAPI.client.tunes_request_client
  end

  # GET /v1/apps/<id>/inAppPurchasesV2 — list all IAPs for an app
  def list_app_iaps(app_id)
    resp = iap_client.get(
      "v1/apps/#{app_id}/inAppPurchasesV2",
      { "limit" => 200 }
    )
    resp.body["data"] || []
  end

  # POST /v2/inAppPurchases — create a new IAP. Returns the resource Hash.
  def create_iap(app_id:, product_id:, name:, in_app_purchase_type:, family_sharable: false)
    resp = iap_client.post(
      "v2/inAppPurchases",
      {
        data: {
          type: "inAppPurchases",
          attributes: {
            productId: product_id,
            name: name,
            inAppPurchaseType: in_app_purchase_type,
            familySharable: family_sharable,
          },
          relationships: { app: { data: { type: "apps", id: app_id } } },
        },
      }
    )
    resp.body["data"]
  end

  # PATCH /v2/inAppPurchases/<id> — update name / familySharable etc.
  def update_iap_attrs(iap_id:, attrs:)
    resp = iap_client.patch(
      "v2/inAppPurchases/#{iap_id}",
      {
        data: { type: "inAppPurchases", id: iap_id, attributes: attrs },
      }
    )
    resp.body["data"]
  end

  # GET /v2/inAppPurchases/<id>/inAppPurchaseLocalizations
  def list_iap_localizations(iap_id)
    resp = iap_client.get(
      "v2/inAppPurchases/#{iap_id}/inAppPurchaseLocalizations",
      { "limit" => 50 }
    )
    resp.body["data"] || []
  end

  def sync_iap_localizations(iap_id:, pid:, source_locs:)
    existing = {}
    list_iap_localizations(iap_id).each do |loc|
      locale = loc.dig("attributes", "locale")
      existing[locale] = loc
    end

    source_locs.each do |locale, fields|
      name = fields.fetch("name")
      description = fields.fetch("description")
      loc = existing[locale]

      if loc.nil?
        UI.message(":: #{pid}/#{locale}: creating localization")
        iap_client.post(
          "v1/inAppPurchaseLocalizations",
          {
            data: {
              type: "inAppPurchaseLocalizations",
              attributes: { locale: locale, name: name, description: description },
              relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: iap_id } } },
            },
          }
        )
      elsif loc.dig("attributes", "name") != name || loc.dig("attributes", "description") != description
        UI.message(":: #{pid}/#{locale}: updating localization")
        iap_client.patch(
          "v1/inAppPurchaseLocalizations/#{loc['id']}",
          {
            data: {
              type: "inAppPurchaseLocalizations",
              id: loc["id"],
              attributes: { name: name, description: description },
            },
          }
        )
      end
    end
  end

  # Apple's IAP V2 pricing uses price points (no legacy tier numbers).
  # POST /v1/inAppPurchasePriceSchedules with the price-point ID for the
  # desired customerPrice in baseTerritory. JWT-verified 2026-05-07.
  # POST replaces the existing schedule (no DELETE needed); each
  # schedule's id == its IAP's id.
  def sync_iap_price(iap_id:, customer_price:, base_territory: "USA")
    cp = customer_price.to_s
    page = iap_client.get(
      "v2/inAppPurchases/#{iap_id}/pricePoints",
      { "filter[territory]" => base_territory, "limit" => 1000 }
    ).body
    point = (page["data"] || []).find { |p| p.dig("attributes", "customerPrice") == cp }
    raise "no price point found in #{base_territory} for customerPrice=#{cp.inspect}" unless point

    iap_client.post("v1/inAppPurchasePriceSchedules", {
      data: {
        type: "inAppPurchasePriceSchedules",
        attributes: {},
        relationships: {
          inAppPurchase: { data: { type: "inAppPurchases", id: iap_id } },
          baseTerritory: { data: { type: "territories", id: base_territory } },
          manualPrices:  { data: [{ type: "inAppPurchasePrices", id: "${newprice-0}" }] },
        }
      },
      included: [{
        id: "${newprice-0}",
        type: "inAppPurchasePrices",
        attributes: { startDate: nil },
        relationships: {
          inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: point["id"] } }
        }
      }]
    })
  end

  # Returns the customerPrice (USD string, e.g. "0.99") for the
  # base-territory manual price, or nil if no schedule exists.
  def fetch_iap_price_tier(iap_id:)
    resp = iap_client.get("v1/inAppPurchasePriceSchedules/#{iap_id}/manualPrices",
                          { "include" => "inAppPurchasePricePoint", "limit" => 10 }).body
    point_ref = (resp["data"] || []).first&.dig("relationships", "inAppPurchasePricePoint", "data", "id")
    return nil unless point_ref
    point = (resp["included"] || []).find { |x| x["type"] == "inAppPurchasePricePoints" && x["id"] == point_ref }
    point&.dig("attributes", "customerPrice")
  rescue StandardError
    nil
  end

  # Apple's IAP availability — which territories the IAP is sold in.
  # POST /v1/inAppPurchaseAvailabilities. JWT-verified 2026-05-07.
  # Idempotent at the OpenAPI level but Apple may 409 if one already
  # exists; we treat that as no-op.
  def sync_iap_availability(iap_id:, territories:, available_in_new_territories: true)
    iap_client.post("v1/inAppPurchaseAvailabilities", {
      data: {
        type: "inAppPurchaseAvailabilities",
        attributes: { availableInNewTerritories: available_in_new_territories },
        relationships: {
          inAppPurchase: { data: { type: "inAppPurchases", id: iap_id } },
          availableTerritories: { data: territories.map { |t| { type: "territories", id: t } } }
        }
      }
    })
  rescue Spaceship::UnexpectedResponse => e
    raise unless e.message =~ /already exists|cannot create another/i
    # Already set — no-op
  end

  # Apple's canonical alpha-3 territory list (~175). Cached per
  # lane invocation. Used both to expand the "ALL" sentinel on push
  # and to recognize an "all-territories" availability on sync (so we
  # can compress 175 entries back into "ALL" in the synced PR).
  # /v1/territories caps limit at 200 — fits all current territories.
  def fetch_all_apple_territories
    @all_apple_territories ||= begin
      resp = iap_client.get("v1/territories", { "limit" => 200 }).body
      (resp["data"] || []).map { |x| x["id"] }.uniq.sort
    end
  end

  # Reads the IAP's current availability — territory list +
  # availableInNewTerritories flag — for the sync direction.
  #
  # Two-step:
  #   1. GET /v2/inAppPurchases/<id>/inAppPurchaseAvailability
  #      → availability resource id + availableInNewTerritories
  #   2. GET /v1/inAppPurchaseAvailabilities/<aid>/availableTerritories?limit=200
  #      → full territory list in one shot (Apple has ~175 territories)
  #
  # The earlier "?include=availableTerritories" approach was capped at
  # 50 by Apple regardless of limit param — pagination of *included*
  # resources is not standard JSON:API and Apple's behavior was to
  # silently truncate. The dedicated availableTerritories endpoint
  # paginates correctly.
  #
  # Returns { "territories" => [<alpha3>, ...], "available_in_new_territories" => bool }
  # or nil if Apple has no availability resource for this IAP.
  def fetch_iap_availability(iap_id:)
    resp = iap_client.get("v2/inAppPurchases/#{iap_id}/inAppPurchaseAvailability").body
    return nil unless resp["data"]

    avail_id = resp.dig("data", "id")
    flag = resp.dig("data", "attributes", "availableInNewTerritories")

    terr_resp = iap_client.get(
      "v1/inAppPurchaseAvailabilities/#{avail_id}/availableTerritories",
      { "limit" => 200 }
    ).body
    territories = (terr_resp["data"] || []).map { |x| x["id"] }.uniq.sort

    {
      "territories"                  => territories,
      "available_in_new_territories" => flag,
    }
  rescue Spaceship::UnexpectedResponse => e
    return nil if e.message =~ /404|not found/i
    raise
  end

  # 3-step Apple asset upload pattern. JWT-verified 2026-05-07.
  #   1. POST /v1/inAppPurchaseAppStoreReviewScreenshots with fileSize+fileName
  #      → response includes uploadOperations array (URL+headers+offset+length)
  #   2. Execute each upload operation (PUT bytes to returned URL)
  #   3. PATCH the screenshot resource with sourceFileChecksum (MD5) +
  #      uploaded:true to commit
  def upload_iap_review_screenshot(iap_id:, path:)
    require "digest"
    require "net/http"
    require "uri"
    raise "screenshot file not found: #{path}" unless File.file?(path)

    bytes = File.binread(path)
    file_size = bytes.bytesize
    file_name = File.basename(path)
    checksum = Digest::MD5.hexdigest(bytes)

    create = iap_client.post("v1/inAppPurchaseAppStoreReviewScreenshots", {
      data: {
        type: "inAppPurchaseAppStoreReviewScreenshots",
        attributes: { fileSize: file_size, fileName: file_name },
        relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: iap_id } } }
      }
    })
    ss_id = create.body.dig("data", "id")
    ops = create.body.dig("data", "attributes", "uploadOperations") || []

    ops.each do |op|
      url = URI(op["url"])
      http = Net::HTTP.new(url.host, url.port)
      http.use_ssl = url.scheme == "https"
      req_class = Net::HTTP.const_get((op["method"] || "PUT").capitalize)
      req = req_class.new(url.request_uri)
      (op["requestHeaders"] || []).each { |h| req[h["name"]] = h["value"] }
      req.body = bytes.byteslice(op["offset"].to_i, op["length"].to_i)
      resp = http.request(req)
      raise "screenshot upload PUT failed: #{resp.code} #{resp.body}" unless resp.code.to_i.between?(200, 299)
    end

    iap_client.patch("v1/inAppPurchaseAppStoreReviewScreenshots/#{ss_id}", {
      data: {
        type: "inAppPurchaseAppStoreReviewScreenshots",
        id: ss_id,
        attributes: { uploaded: true, sourceFileChecksum: checksum }
      }
    })
    ss_id
  end

  def download_iap_review_screenshot(iap_id:, dest_path:)
    require "open-uri"
    asset = iap_client.get("v2/inAppPurchases/#{iap_id}/appStoreReviewScreenshot")
                      .body.dig("data", "attributes", "imageAsset")
    return unless asset && asset["templateUrl"]
    width  = asset["width"]  || 640
    height = asset["height"] || 920
    url = asset["templateUrl"].gsub("{w}", width.to_s).gsub("{h}", height.to_s).gsub("{c}", "bb").gsub("{f}", "png")
    URI.open(url) { |remote| File.binwrite(dest_path, remote.read) }
  rescue StandardError
    # Best-effort — silent skip
  end

  # POST /v1/inAppPurchaseSubmissions. JWT-verified 2026-05-07.
  # Apple validates state + missing-fields server-side. If anything's
  # off (missing screenshot, app-level Privacy URL absent, etc.) Apple
  # returns descriptive errors. We re-raise so the caller's rescue
  # surfaces them as warnings.
  SUBMITTABLE_IAP_STATES = %w[MISSING_METADATA DEVELOPER_ACTION_NEEDED READY_TO_SUBMIT].freeze

  def submit_iap_for_review(iap_id:)
    state = iap_client.get("v2/inAppPurchases/#{iap_id}").body.dig("data", "attributes", "state")
    unless SUBMITTABLE_IAP_STATES.include?(state)
      UI.message(":: IAP #{iap_id} state=#{state.inspect} — not submittable, skipping")
      return
    end

    iap_client.post("v1/inAppPurchaseSubmissions", {
      data: {
        type: "inAppPurchaseSubmissions",
        relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: iap_id } } }
      }
    })
  end

  # ──────────────────────────────────────────────
  # update_subscription
  #
  # Upserts auto-renewable subscription groups + their subscriptions
  # against Apple's /v1/subscriptions* endpoints. Idempotent — matches
  # groups by reference_name and subs by product_id; creates if absent,
  # PATCHes attribute drift otherwise. After each subscription is in
  # shape (localized, priced, availability set, optional screenshot),
  # the lane submits the WHOLE GROUP for review via
  # POST /v1/subscriptionGroupSubmissions (group-level submission is
  # an Apple choice — different from IAPs which submit one at a time).
  #
  # Source layout (per group):
  #   <group_folder>/
  #     group.jsonc                 # { reference_name }
  #     Text/defaults/info.jsonc    # shared { name, custom_app_name }
  #     Text/<locale>/info.jsonc    # per-locale overrides
  #     <product_id>/
  #       subscription.jsonc        # period, group_level, family_shareable,
  #                                 # customer_price, territories, ...
  #       review_screenshot.png     # 640×920 PNG (optional but rec'd)
  #       Text/defaults/info.jsonc  # shared { name, description }
  #       Text/<locale>/info.jsonc  # per-locale overrides
  #
  # Usage: bundle exec fastlane update_subscription input_path:/tmp/sub-normalized.json
  # ──────────────────────────────────────────────
  lane :update_subscription do |options|
    require "spaceship"
    require "json"

    input_path = options[:input_path]
    UI.user_error!("Missing input_path") if input_path.to_s.empty?
    UI.user_error!("Subscription input file not found: #{input_path}") unless File.exist?(input_path)

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    app = find_iap_app_or_explain!(ENV.fetch("APP_BUNDLE_ID"))
    source = JSON.parse(File.read(input_path))
    groups = source.fetch("groups", [])
    UI.user_error!("No subscription groups in #{input_path}") if groups.empty?

    existing_groups = {}
    list_app_subscription_groups(app.id).each do |g|
      existing_groups[g.dig("attributes", "referenceName")] = g
    end
    UI.message(":: App has #{existing_groups.size} existing subscription group(s) on ASC")

    warnings = []

    groups.each do |group|
      ref = group.fetch("reference_name")
      grp = existing_groups[ref]

      if grp.nil?
        UI.message(":: Creating subscription group '#{ref}'")
        grp = create_subscription_group(app_id: app.id, reference_name: ref)
      else
        UI.message(":: Subscription group '#{ref}' already exists (id=#{grp['id']})")
      end

      group_id = grp["id"]
      sync_subscription_group_localizations(group_id: group_id, ref: ref, source_locs: group.fetch("localizations", {}))

      existing_subs = {}
      list_group_subscriptions(group_id).each do |s|
        existing_subs[s.dig("attributes", "productId")] = s
      end

      group.fetch("subscriptions", []).each do |sub|
        pid = sub.fetch("product_id")
        existing = existing_subs[pid]

        if existing.nil?
          UI.message(":: Creating subscription '#{pid}' (period=#{sub['subscription_period']})")
          existing = create_subscription(
            group_id: group_id,
            product_id: pid,
            name: sub.fetch("reference_name"),
            family_sharable: sub.fetch("family_shareable", true),
            subscription_period: sub.fetch("subscription_period"),
            group_level: sub.fetch("group_level", 1),
            review_note: sub["review_note"],
          )
        else
          attrs = {}
          attrs[:name]          = sub["reference_name"]    if existing.dig("attributes", "name") != sub["reference_name"]
          if !existing.dig("attributes", "familySharable").nil? && existing.dig("attributes", "familySharable") != sub["family_shareable"]
            attrs[:familySharable] = sub["family_shareable"]
          end
          attrs[:groupLevel]    = sub["group_level"]       if sub["group_level"] && existing.dig("attributes", "groupLevel") != sub["group_level"]
          attrs[:reviewNote]    = sub["review_note"]       if sub.key?("review_note") && existing.dig("attributes", "reviewNote") != sub["review_note"]
          # subscriptionPeriod is immutable post-create — Apple errors on PATCH attempt
          unless attrs.empty?
            UI.message(":: Updating subscription '#{pid}' (#{attrs.keys.join(', ')})")
            update_subscription_attrs(sub_id: existing["id"], attrs: attrs)
          end
        end

        sub_id = existing["id"]
        sync_subscription_localizations(sub_id: sub_id, pid: pid, source_locs: sub.fetch("localizations"))

        if sub["customer_price"]
          begin
            sync_subscription_price(sub_id: sub_id, customer_price: sub["customer_price"])
          rescue StandardError => e
            warnings << "#{pid}: base price update failed: #{e.message}"
          end
        end

        # Per-territory price overrides on top of customer_price (USD base).
        # Each entry POSTs a SubscriptionPrice with the matching local-currency
        # price point + the territory rel; idempotent (skipped if Apple already
        # has that exact (territory, price) combination).
        # NOTE: this lane is additive — removing a territory from the file does
        # NOT clear an existing override on Apple. To remove an override, set
        # it to the same value as customer_price (Apple replaces it).
        (sub["territory_prices"] || {}).each do |territory, price|
          begin
            sync_subscription_price(sub_id: sub_id, customer_price: price, territory: territory)
          rescue StandardError => e
            warnings << "#{pid}: #{territory} price override failed: #{e.message}"
          end
        end

        if sub["territories"]
          begin
            territories = sub["territories"]
            territories = fetch_all_apple_territories if territories == "ALL"
            sync_subscription_availability(
              sub_id: sub_id,
              territories: territories,
              available_in_new_territories: sub.fetch("available_in_new_territories", true)
            )
          rescue StandardError => e
            warnings << "#{pid}: availability update failed: #{e.message}"
          end
        end

        if sub["review_screenshot"]
          begin
            upload_subscription_review_screenshot(sub_id: sub_id, path: sub["review_screenshot"])
          rescue StandardError => e
            warnings << "#{pid}: review screenshot upload failed: #{e.message}"
          end
        end
      end

      # Group-level submission — submits every subscription in the
      # group at once. Best-effort; subscriptions sit in
      # MISSING_METADATA until Apple validates everything (which can
      # take some time even after we've set price/availability/
      # screenshot/localizations). If the submission errors here,
      # re-running the workflow later usually succeeds.
      begin
        submit_subscription_group_for_review(group_id: group_id)
        UI.success(":: Submitted group '#{ref}' for review")
      rescue StandardError => e
        warnings << "group '#{ref}': submission deferred — #{e.message}. Re-run after subs reach READY_TO_SUBMIT."
      end
    end

    if warnings.any?
      warnings.each { |w| UI.important(":: WARNING: #{w}") }
      UI.success("Done — #{warnings.size} warning(s) above (non-fatal).")
    else
      UI.success("Done — all subscriptions synced cleanly.")
    end
  end

  # ──────────────────────────────────────────────
  # fetch_subscription
  #
  # Mirror of update_subscription. Dumps every auto-renewable
  # subscription group + its subscriptions to a flat layout that
  # reverse_transform_subscription.rb consumes:
  #   {output_path}/{group_ref}/group.json
  #   {output_path}/{group_ref}/Text/{locale}/info.json
  #   {output_path}/{group_ref}/{product_id}/subscription.json
  #   {output_path}/{group_ref}/{product_id}/review_screenshot.png  (if present)
  #   {output_path}/{group_ref}/{product_id}/Text/{locale}/info.json
  #
  # Schema parity with update_subscription is a contract — every push
  # field must be populated here so a synced PR can be re-pushed.
  #
  # Usage: bundle exec fastlane fetch_subscription output_path:/tmp/sub-dump
  # ──────────────────────────────────────────────
  lane :fetch_subscription do |options|
    require "spaceship"
    require "fileutils"
    require "json"
    require "open-uri"

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8_PATH"),
    )

    output_path = options[:output_path] || "."
    FileUtils.mkdir_p(output_path)

    app = find_iap_app_or_explain!(ENV.fetch("APP_BUNDLE_ID"))
    groups = list_app_subscription_groups(app.id)
    written_groups = 0

    groups.each do |grp|
      ref = grp.dig("attributes", "referenceName")
      group_dir = File.join(output_path, ref)
      FileUtils.mkdir_p(group_dir)

      File.write(
        File.join(group_dir, "group.json"),
        JSON.pretty_generate({ "reference_name" => ref })
      )

      text_dir = File.join(group_dir, "Text")
      FileUtils.mkdir_p(text_dir)
      list_subscription_group_localizations(grp["id"]).each do |loc|
        locale = loc.dig("attributes", "locale")
        next if locale.to_s.empty?
        locale_dir = File.join(text_dir, locale)
        FileUtils.mkdir_p(locale_dir)
        File.write(
          File.join(locale_dir, "info.json"),
          JSON.pretty_generate({
            "name"            => loc.dig("attributes", "name"),
            "custom_app_name" => loc.dig("attributes", "customAppName"),
          })
        )
      end

      list_group_subscriptions(grp["id"]).each do |sub|
        pid = sub.dig("attributes", "productId")
        sub_dir = File.join(group_dir, pid)
        FileUtils.mkdir_p(sub_dir)

        availability = fetch_subscription_availability(sub_id: sub["id"]) || {}
        territories  = availability["territories"] || []
        all_apple    = fetch_all_apple_territories
        territories_field = (territories.size == all_apple.size && territories == all_apple) ? "ALL" : territories

        # Apple stores subscription prices as one SubscriptionPrice per
        # (sub, territory) — there is no separate "base, no-territory"
        # concept. The lane treats USD = USA as the canonical anchor:
        # customer_price round-trips as the USA price; everything else
        # goes into territory_prices.
        all_prices       = fetch_subscription_all_prices(sub_id: sub["id"])
        base_price       = all_prices["USA"] || all_prices[nil]
        territory_prices = all_prices.reject { |k, _| k.nil? || k == "USA" }   # {} if no overrides

        meta = {
          "type"                         => "auto_renewable_subscription",
          "reference_name"               => sub.dig("attributes", "name"),
          "subscription_period"          => sub.dig("attributes", "subscriptionPeriod"),
          "family_shareable"             => sub.dig("attributes", "familySharable") == true,
          "group_level"                  => sub.dig("attributes", "groupLevel"),
          "review_note"                  => sub.dig("attributes", "reviewNote"),
          "customer_price"               => base_price,
          "territory_prices"             => territory_prices,    # {} when no overrides
          "territories"                  => territories_field,
          "available_in_new_territories" => availability.fetch("available_in_new_territories", true),
        }
        File.write(File.join(sub_dir, "subscription.json"), JSON.pretty_generate(meta))

        loc_text_dir = File.join(sub_dir, "Text")
        FileUtils.mkdir_p(loc_text_dir)
        list_subscription_localizations(sub["id"]).each do |loc|
          locale = loc.dig("attributes", "locale")
          next if locale.to_s.empty?
          locale_dir = File.join(loc_text_dir, locale)
          FileUtils.mkdir_p(locale_dir)
          File.write(
            File.join(locale_dir, "info.json"),
            JSON.pretty_generate({
              "name"        => loc.dig("attributes", "name"),
              "description" => loc.dig("attributes", "description"),
            })
          )
        end

        begin
          download_subscription_review_screenshot(sub_id: sub["id"], dest_path: File.join(sub_dir, "review_screenshot.png"))
        rescue StandardError => e
          UI.important(":: #{pid}: could not download review screenshot: #{e.message}")
        end

        UI.message(":: Dumped subscription #{pid}")
      end

      written_groups += 1
      UI.message(":: Dumped group '#{ref}'")
    end

    UI.success("Dumped #{written_groups} subscription group(s) to #{output_path}.")
  end

  # ── Subscription helpers (private to update_subscription / fetch_subscription) ──

  # GET /v1/apps/<id>/subscriptionGroups
  def list_app_subscription_groups(app_id)
    resp = iap_client.get("v1/apps/#{app_id}/subscriptionGroups", { "limit" => 200 }).body
    resp["data"] || []
  end

  # POST /v1/subscriptionGroups
  def create_subscription_group(app_id:, reference_name:)
    resp = iap_client.post("v1/subscriptionGroups", {
      data: {
        type: "subscriptionGroups",
        attributes: { referenceName: reference_name },
        relationships: { app: { data: { type: "apps", id: app_id } } },
      }
    })
    resp.body["data"]
  end

  # GET /v1/subscriptionGroups/<id>/subscriptionGroupLocalizations
  def list_subscription_group_localizations(group_id)
    resp = iap_client.get("v1/subscriptionGroups/#{group_id}/subscriptionGroupLocalizations",
                          { "limit" => 200 }).body
    resp["data"] || []
  end

  # Upserts group localizations by locale. Same patch-or-create dance
  # as IAP localizations.
  def sync_subscription_group_localizations(group_id:, ref:, source_locs:)
    existing = {}
    list_subscription_group_localizations(group_id).each do |loc|
      existing[loc.dig("attributes", "locale")] = loc
    end

    source_locs.each do |locale, fields|
      name      = fields["name"]
      custom    = fields["custom_app_name"]
      if existing[locale]
        loc_id = existing[locale]["id"]
        attrs  = {}
        attrs[:name]          = name   if name && existing[locale].dig("attributes", "name") != name
        attrs[:customAppName] = custom if custom && existing[locale].dig("attributes", "customAppName") != custom
        next if attrs.empty?
        iap_client.patch("v1/subscriptionGroupLocalizations/#{loc_id}", {
          data: { type: "subscriptionGroupLocalizations", id: loc_id, attributes: attrs }
        })
        UI.message(":: group '#{ref}' / #{locale}: localization updated (#{attrs.keys.join(', ')})")
      else
        iap_client.post("v1/subscriptionGroupLocalizations", {
          data: {
            type: "subscriptionGroupLocalizations",
            attributes: { name: name, customAppName: custom, locale: locale }.compact,
            relationships: {
              subscriptionGroup: { data: { type: "subscriptionGroups", id: group_id } }
            }
          }
        })
        UI.message(":: group '#{ref}' / #{locale}: localization created")
      end
    end
  end

  # GET /v1/subscriptionGroups/<id>/subscriptions
  def list_group_subscriptions(group_id)
    resp = iap_client.get("v1/subscriptionGroups/#{group_id}/subscriptions",
                          { "limit" => 200 }).body
    resp["data"] || []
  end

  # POST /v1/subscriptions
  # subscription_period must be one of: ONE_WEEK, ONE_MONTH, TWO_MONTHS,
  # THREE_MONTHS, SIX_MONTHS, ONE_YEAR. Period is IMMUTABLE post-create.
  def create_subscription(group_id:, product_id:, name:, family_sharable:, subscription_period:, group_level:, review_note: nil)
    attrs = {
      productId:          product_id,
      name:               name,
      familySharable:     family_sharable,
      subscriptionPeriod: subscription_period,
      groupLevel:         group_level,
    }
    attrs[:reviewNote] = review_note if review_note

    resp = iap_client.post("v1/subscriptions", {
      data: {
        type: "subscriptions",
        attributes: attrs,
        relationships: { group: { data: { type: "subscriptionGroups", id: group_id } } },
      }
    })
    resp.body["data"]
  end

  def update_subscription_attrs(sub_id:, attrs:)
    resp = iap_client.patch("v1/subscriptions/#{sub_id}", {
      data: { type: "subscriptions", id: sub_id, attributes: attrs }
    })
    resp.body["data"]
  end

  # GET /v1/subscriptions/<id>/subscriptionLocalizations
  def list_subscription_localizations(sub_id)
    resp = iap_client.get("v1/subscriptions/#{sub_id}/subscriptionLocalizations",
                          { "limit" => 200 }).body
    resp["data"] || []
  end

  def sync_subscription_localizations(sub_id:, pid:, source_locs:)
    existing = {}
    list_subscription_localizations(sub_id).each do |loc|
      existing[loc.dig("attributes", "locale")] = loc
    end

    source_locs.each do |locale, fields|
      name = fields.fetch("name")
      desc = fields.fetch("description")
      if existing[locale]
        loc_id = existing[locale]["id"]
        attrs  = {}
        attrs[:name]        = name if existing[locale].dig("attributes", "name") != name
        attrs[:description] = desc if existing[locale].dig("attributes", "description") != desc
        next if attrs.empty?
        iap_client.patch("v1/subscriptionLocalizations/#{loc_id}", {
          data: { type: "subscriptionLocalizations", id: loc_id, attributes: attrs }
        })
        UI.message(":: #{pid}/#{locale}: localization updated (#{attrs.keys.join(', ')})")
      else
        iap_client.post("v1/subscriptionLocalizations", {
          data: {
            type: "subscriptionLocalizations",
            attributes: { name: name, description: desc, locale: locale },
            relationships: { subscription: { data: { type: "subscriptions", id: sub_id } } }
          }
        })
        UI.message(":: #{pid}/#{locale}: localization created")
      end
    end
  end

  # GET /v1/subscriptions/<id>/pricePoints?filter[territory]=USA
  # Returns the matching subscriptionPricePoint resource ID for a USD
  # customer price (e.g. "4.99"). Apple keys subscription price points
  # by USD price in USA territory and derives equivalents elsewhere.
  # Find Apple's subscriptionPricePoint id for a (territory, customer_price)
  # tuple. Apple keys price points by territory + currency; each territory's
  # price-point list can be hundreds of entries (USA has ~800), so we
  # paginate via JSON:API links.next until we either find the match or
  # exhaust the list.
  def fetch_subscription_price_point_id(sub_id:, customer_price:, territory: "USA")
    next_url = "v1/subscriptions/#{sub_id}/pricePoints"
    params   = { "filter[territory]" => territory, "limit" => 200 }

    loop do
      resp = if next_url.start_with?("http")
               # Apple returns absolute URLs for cursor pagination; strip the base.
               uri = URI.parse(next_url)
               iap_client.get("#{uri.path}?#{uri.query}".sub(%r{\A/}, "")).body
             else
               iap_client.get(next_url, params).body
             end
      params = nil

      match = (resp["data"] || []).find { |p| p.dig("attributes", "customerPrice") == customer_price }
      return match["id"] if match

      next_url = resp.dig("links", "next")
      break unless next_url
    end

    raise "No subscription price point in #{territory} matches customerPrice=#{customer_price.inspect}"
  end

  # GET /v1/subscriptions/<id>/prices?include=subscriptionPricePoint
  # Returns a hash of territory→customer_price for every price set on
  # the sub. Key nil means "the base price" (no territory rel — Apple
  # derives equivalents for all unlisted territories from this).
  # Used both by sync (to skip already-correct prices) and by fetch
  # (to populate territory_prices in the round-trip dump).
  def fetch_subscription_all_prices(sub_id:)
    resp = iap_client.get("v1/subscriptions/#{sub_id}/prices", {
      "include" => "subscriptionPricePoint,territory",
      "limit"   => 200,
    }).body
    included_points = ((resp["included"] || []).select { |x| x["type"] == "subscriptionPricePoints" })
                        .each_with_object({}) { |x, h| h[x["id"]] = x.dig("attributes", "customerPrice") }

    out = {}
    (resp["data"] || []).each do |price|
      point_id    = price.dig("relationships", "subscriptionPricePoint", "data", "id")
      territory   = price.dig("relationships", "territory", "data", "id")  # nil if base price
      customer_p  = included_points[point_id]
      out[territory] = customer_p if customer_p
    end
    out
  rescue StandardError
    {}
  end

  # Backwards-compat wrapper — returns just the base price.
  def fetch_subscription_current_price(sub_id:)
    fetch_subscription_all_prices(sub_id: sub_id)[nil]
  end

  # POST /v1/subscriptionPrices — sets a price for the subscription.
  # Without `territory:` → applies as the base price (Apple derives
  # equivalents for unlisted territories via its pricing matrix).
  # With `territory:` → overrides the price for that specific territory
  # only. customer_price is the local-currency string for that territory
  # (e.g. "5.99" for DEU/EUR, "650" for JPN/JPY no-decimal).
  # Idempotent: skips POST if the current price for that territory
  # (or base) already matches.
  def sync_subscription_price(sub_id:, customer_price:, territory: nil)
    current = fetch_subscription_all_prices(sub_id: sub_id)
    return if current[territory] == customer_price

    point_id = fetch_subscription_price_point_id(
      sub_id: sub_id,
      customer_price: customer_price,
      territory: territory || "USA",
    )

    rels = {
      subscription:           { data: { type: "subscriptions",           id: sub_id   } },
      subscriptionPricePoint: { data: { type: "subscriptionPricePoints", id: point_id } },
    }
    rels[:territory] = { data: { type: "territories", id: territory } } if territory

    iap_client.post("v1/subscriptionPrices", {
      data: {
        type: "subscriptionPrices",
        attributes: { startDate: nil, preserveCurrentPrice: false },
        relationships: rels,
      }
    })
  end

  # GET /v1/subscriptions/<id>/subscriptionAvailability
  # Two-step like IAP: get availability resource → then GET its
  # availableTerritories (limit=200 covers all 175).
  def fetch_subscription_availability(sub_id:)
    resp = iap_client.get("v1/subscriptions/#{sub_id}/subscriptionAvailability").body
    return nil unless resp["data"]

    avail_id = resp.dig("data", "id")
    flag = resp.dig("data", "attributes", "availableInNewTerritories")

    terr_resp = iap_client.get(
      "v1/subscriptionAvailabilities/#{avail_id}/availableTerritories",
      { "limit" => 200 }
    ).body
    territories = (terr_resp["data"] || []).map { |x| x["id"] }.uniq.sort

    {
      "territories"                  => territories,
      "available_in_new_territories" => flag,
    }
  rescue Spaceship::UnexpectedResponse => e
    return nil if e.message =~ /404|not found/i
    raise
  end

  # POST /v1/subscriptionAvailabilities
  def sync_subscription_availability(sub_id:, territories:, available_in_new_territories: true)
    iap_client.post("v1/subscriptionAvailabilities", {
      data: {
        type: "subscriptionAvailabilities",
        attributes: { availableInNewTerritories: available_in_new_territories },
        relationships: {
          subscription:         { data: { type: "subscriptions", id: sub_id } },
          availableTerritories: { data: territories.map { |t| { type: "territories", id: t } } }
        }
      }
    })
  rescue Spaceship::UnexpectedResponse => e
    raise unless e.message =~ /already exists|cannot create another/i
    # Already set — no-op
  end

  # 3-step asset upload pattern (mirrors IAP):
  #   1. POST /v1/subscriptionAppStoreReviewScreenshots with fileSize+fileName
  #   2. PUT bytes via uploadOperations
  #   3. PATCH commit with sourceFileChecksum + uploaded:true
  def upload_subscription_review_screenshot(sub_id:, path:)
    require "digest"
    require "net/http"
    require "uri"
    raise "screenshot file not found: #{path}" unless File.file?(path)

    bytes     = File.binread(path)
    file_size = bytes.bytesize
    file_name = File.basename(path)
    md5       = Digest::MD5.hexdigest(bytes)

    create_resp = iap_client.post("v1/subscriptionAppStoreReviewScreenshots", {
      data: {
        type: "subscriptionAppStoreReviewScreenshots",
        attributes: { fileName: file_name, fileSize: file_size },
        relationships: { subscription: { data: { type: "subscriptions", id: sub_id } } }
      }
    })
    asset_id   = create_resp.body.dig("data", "id")
    operations = create_resp.body.dig("data", "attributes", "uploadOperations") || []

    operations.each do |op|
      uri  = URI.parse(op["url"])
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = (uri.scheme == "https")
      req  = Net::HTTP::Put.new(uri.request_uri)
      (op["requestHeaders"] || []).each { |h| req[h["name"]] = h["value"] }
      offset = op["offset"] || 0
      length = op["length"] || file_size
      req.body = bytes[offset, length]
      resp = http.request(req)
      raise "PUT #{uri} failed: #{resp.code} #{resp.body}" unless resp.is_a?(Net::HTTPSuccess)
    end

    iap_client.patch("v1/subscriptionAppStoreReviewScreenshots/#{asset_id}", {
      data: {
        type: "subscriptionAppStoreReviewScreenshots",
        id: asset_id,
        attributes: { uploaded: true, sourceFileChecksum: md5 }
      }
    })
  rescue Spaceship::UnexpectedResponse => e
    # Apple keeps one screenshot per subscription; trying to create a
    # second errors with "Screenshot already exists". Skip silently —
    # if you need to replace, DELETE the existing one first via the
    # ASC UI (replacement-via-API is a v2 feature).
    raise unless e.message =~ /already exists/i
  end

  # GET /v1/subscriptions/<id>/appStoreReviewScreenshot
  def download_subscription_review_screenshot(sub_id:, dest_path:)
    resp = iap_client.get("v1/subscriptions/#{sub_id}/appStoreReviewScreenshot").body
    asset = resp["data"]
    return unless asset

    asset_url = asset.dig("attributes", "imageAsset", "templateUrl")
    return unless asset_url

    width  = asset.dig("attributes", "imageAsset", "width")  || 640
    height = asset.dig("attributes", "imageAsset", "height") || 920
    url    = asset_url.gsub("{w}", width.to_s).gsub("{h}", height.to_s).gsub("{f}", "png")

    URI.open(url) do |io|
      File.open(dest_path, "wb") { |f| f.write(io.read) }
    end
  end

  # POST /v1/subscriptionGroupSubmissions — submits the WHOLE GROUP
  # for review (every sub in it). Apple's grouping forces an all-at-once
  # submission, which is actually nicer than IAP's per-resource submit.
  def submit_subscription_group_for_review(group_id:)
    iap_client.post("v1/subscriptionGroupSubmissions", {
      data: {
        type: "subscriptionGroupSubmissions",
        relationships: { subscriptionGroup: { data: { type: "subscriptionGroups", id: group_id } } }
      }
    })
  end

  # ── shared helper ───────────────────────────────────────────
  # Lightweight JSONC parser: strips UTF-8 BOM, // line comments
  # outside quoted strings, and trailing commas before } / ].
  # Same approach as submit_for_review's inline parser and
  # scripts/transform_metadata.rb (kept in sync deliberately).
  def parse_jsonc(raw)
    require "json"
    raw = raw.dup
    raw = raw.delete_prefix("\xEF\xBB\xBF")
    raw = raw.gsub(%r{^\s*//.*$}, "")
    raw = raw.gsub(/,\s*([}\]])/, '\1')
    JSON.parse(raw)
  end

end
